  "cards": [
    {
      "dot": "cyan",
      "title": "Perimeter & Outbox Pattern",
      "items": [
        "Inbound requests validated at Spring Cloud Gateway in sub-5ms",
        "Transfer record and outbox event written within one atomic Oracle transaction",
        "Client receives immediate HTTP 202 Accepted without holding open persistence locks"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ordered Partition Settlement",
      "items": [
        "Transfers partitioned by source_account_id guaranteeing strict sequence per account",
        "Consumer thread acquires pessimistic lock via SELECT ... FOR UPDATE on Oracle rows",
        "Settlement updates balance amounts and publishes TransferExecuted event"
      ]
    },
    {
      "dot": "violet",
      "title": "Asynchronous Fan-Out Projections",
      "items": [
        "PostgreSQL audit consumer reads event stream and inserts immutable journal records",
        "Audit consumer lag or database maintenance never impedes balance settlement",
        "Notification service delivers real-time email advices and receipts to customer inboxes"
      ]
    }
