  "cards": [
    {
      "dot": "cyan",
      "title": "Perimeter & Client Ports",
      "items": [
        "React SPA running on port 3000 with Customer (email 2FA OTP modal) and Admin telemetry portals",
        "Spring Cloud Gateway on port 8080 handling stateless JWT verification and rate limiting",
        "Redis on port 6379 for token rotation, blacklist, and 2FA OTP cache (5-minute TTL)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend Microservice Ports",
      "items": [
        "Account Service running on port 8081 (KYC, provisioning, user lifecycle)",
        "Core Mutation Engine on port 8082 executing pessimistic locks, 50k soft hold, and outbox events",
        "Notification Service on port 8083 consuming Kafka transaction event and customer OTP topics"
      ]
    },
    {
      "dot": "rose",
      "title": "Storage, Mail & Event Streaming",
      "items": [
        "MailHog Mock SMTP on :8025 (Web UI) and :1025 (SMTP) for OTP and receipt delivery",
        "Oracle XE 21c on port 1521 holding mutable account balance master records and outbox log",
        "PostgreSQL 16 on port 5432 storing immutable ledger_mutation_audit projection"
      ]
    }
