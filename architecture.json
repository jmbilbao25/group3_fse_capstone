        "label": "Event-driven transfer & outbox",
        "focus": ["client", "gateway", "tx_engine", "master_db", "broker"],
        "note": "Decouples transfer ingestion from execution via Transactional Outbox and Kafka command partitions."
      },
      {
        "id": "email-otp-verification",
        "label": "Email 2FA OTP verification (> 50k PHP)",
        "focus": ["client", "gateway", "tx_engine", "broker", "notif_svc", "mailhog"],
        "note": "Transfers exceeding 50k PHP trigger soft hold; 6-digit OTP dispatched to customer email via MailHog for self-service verification."
      },
      {
        "id": "perimeter-auth",
        "label": "Perimeter security & caching",
        "focus": ["client", "gateway", "auth_cache", "acc_svc"],
        "note": "Stateless JWT access token verification, Redis token family rotation, and rate limiting."
      },
      {
        "id": "audit-and-alert",
        "label": "Asynchronous audit & alerts",
        "focus": ["broker", "audit_db", "notif_svc", "mailhog"],
        "note": "Kafka event fan-out streaming immutable audit entries to PostgreSQL and receipts to notifications and MailHog."
      }
    ]
