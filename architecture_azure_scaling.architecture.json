  "cards": [
    {
      "dot": "amber",
      "title": "Multi-Tier Load Balancing",
      "items": [
        "Tier 1: Azure App Gateway v2 terminates SSL/TLS at the edge, runs OWASP WAF, and routes /api/* to Gateway and /* to Frontend.",
        "Tier 2: Azure Container Apps embedded Envoy proxy routes east-west microservice traffic using internal virtual DNS.",
        "Tier 3: Built-in PgBouncer and HikariCP connection pools (capped at 30 conns) protect databases from connection exhaustion."
      ]
    },
    {
      "dot": "violet",
      "title": "Event-Driven & Reactive Autoscaling",
      "items": [
        "Stateless frontend, gateway, and account services scale horizontally via HPA based on CPU (>70%) and concurrent requests.",
        "Ledger Mutation Engine and Notification Service scale via KEDA driven by consumer lag on Kafka/Event Hubs topics.",
        "Partitioning by source_account_id (6 partitions) guarantees strict chronological transaction order per account."
      ]
    },
    {
      "dot": "emerald",
      "title": "Dual-Storage Relational Persistence",
      "items": [
        "Oracle XE 21c master database executes pessimistic row locks (SELECT FOR UPDATE) and stores transactional outbox events.",
        "Azure Database for PostgreSQL Flexible Server stores append-only mutation journals protected by immutable triggers.",
        "Azure Cache for Redis provides sub-5ms token blacklist checks and absorbs 80%+ of account balance inquiries."
      ]
    }
  ]
