  "cards": [
    {
      "dot": "amber",
      "title": "Azure Kubernetes Service & CI/CD Pipeline",
      "items": [
        "GitHub Actions CI/CD: Automated linting, unit testing, and Trivy security scanning; publishes multi-arch container images to Azure Container Registry (ACR).",
        "AKS Ingress & Autoscaling: Azure App Gateway v2 with WAF terminates SSL; Gateway and Orchestrator pods autoscale via HPA (2 to 10 replicas) based on CPU and RPS.",
        "Datadog DaemonSet: Datadog Agent DaemonSet runs on every AKS node, collecting container metrics, distributed OTLP traces, and streaming pod logs."
      ]
    },
    {
      "dot": "violet",
      "title": "Azure SQL Database with Ledger & Event Hubs",
      "items": [
        "Azure SQL Database & Ledger: Single unified database replacing Oracle and PostgreSQL; utilizes Azure SQL Ledger tables for cryptographically verifiable, append-only audit trails.",
        "ACID Concurrency: Spring Boot Orchestrator acquires pessimistic row locks (SELECT ... WITH (UPDLOCK, ROWLOCK)) in Azure SQL, preventing overdrafts and race conditions.",
        "Azure Event Hubs & Redis: Event Hubs provides managed Kafka API (:9093) for outbox events; Azure Cache for Redis manages RTR token families and 5-min OTPs."
      ]
    }
  ]
