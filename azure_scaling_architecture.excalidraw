    {
      "id": "text_103_efsqf9",
      "type": "text",
      "x": 570,
      "y": 1220,
      "width": 327,
      "height": 205,
      "angle": 0,
      "strokeColor": "#fff7ed",
      "backgroundColor": "transparent",
