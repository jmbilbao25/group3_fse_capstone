      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 8115,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "text": "• Production replacement for local MailHog\n• Delivers real 6-digit OTP codes via SMTP\n  (:587 TLS) for transfers > ₱50,000.00\n• Dispatches rich HTML debit/credit receipts\n  with masked accounts & SHA-256 hash\n• In-memory retry spooling for network blips",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "• Production replacement for local MailHog\n• Delivers real 6-digit OTP codes via SMTP\n  (:587 TLS) for transfers > ₱50,000.00\n• Dispatches rich HTML debit/credit receipts\n  with masked accounts & SHA-256 hash\n• In-memory retry spooling for network blips",
      "lineHeight": 1.42
