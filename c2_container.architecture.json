  "cards": [
    {
      "dot": "emerald",
      "title": "BFF Architecture & Dedicated Database Separation",
      "items": [
        "Dedicated BFF Database (:5433): Completely decoupled from the CBS Master DB; stores user UI preferences, device registrations, draft transfer states, and client aggregation caches.",
        "Zero CBS Master DB Contention: High-throughput client polling and draft saves hit the BFF Database, protecting the mission-critical Core Banking System from lock contention."
      ]
    },
    {
      "dot": "amber",
      "title": "Temenos T24 CBS Dual-Endpoint Architecture",
      "items": [
        "Endpoint 1 (/api/v1/t24/funds-transfer): Ingests validated transfer commands and executes atomic debit/credit balance mutations in Azure SQL Master DB (:1433).",
        "Endpoint 2 (/api/v1/t24/reversal): Executes compensating financial reversals if downstream notifications, network timeouts, or OTP verifications abort the transaction saga."
      ]
    }
  ]
