  "cards": [
    {
      "dot": "emerald",
      "title": "Dual-Storage Ledger & Audit Vault Architecture",
      "items": [
        "Master Operational DB (Azure SQL :1433): Dedicated to Temenos T24 CBS for double-entry financial journals and row-level pessimistic balance locks (UPDLOCK, ROWLOCK).",
        "Immutable Regulatory Vault (PostgreSQL 16 :5432): Asynchronously streams events from Kafka, enforcing an append-only audit trail with DB triggers blocking UPDATE and DELETE."
      ]
    },
    {
      "dot": "amber",
      "title": "Temenos T24 CBS Dual-Endpoint Architecture",
      "items": [
        "Endpoint 1 (/api/v1/t24/funds-transfer): Ingests validated transfer commands and executes atomic debit/credit balance mutations in Azure SQL Master DB (:1433).",
        "Endpoint 2 (/api/v1/t24/reversal): Executes compensating financial reversals if downstream notifications, network timeouts, or OTP verifications abort the transaction saga."
      ]
    }
  ]
