      "dot": "cyan",
      "title": "Transfer Orchestrator & Saga Workflow",
      "items": [
        "Idempotency & Risk: Enforces unique mutation tokens in Redis and evaluates 2FA challenge thresholds before dispatching to T24.",
        "Compensating Rollback: If any downstream service or notification times out, Saga Coordinator automatically triggers T24 Reversal Client."
      ]
    },
    {
      "dot": "rose",
      "title": "Temenos T24 Dual Ingress Endpoints & Master Ledger",
      "items": [
        "Endpoint 1 (/funds-transfer): Processes standard debit/credit mutations and updates balance_master in Azure SQL.",
        "Endpoint 2 (/reversal): Ingests compensation requests with original TXN.REF, restoring customer balances and posting reversing general ledger entries."
      ]
    }
