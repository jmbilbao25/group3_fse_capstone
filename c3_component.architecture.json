  "cards": [
    {
      "dot": "cyan",
      "title": "BFF Database & State Isolation",
      "items": [
        "BFF State Repository: Manages draft transfers, user preferences, and client aggregation models exclusively in bff_db (:5433).",
        "Zero CBS Overhead: Customer-facing drafts and frontend state caching never interact with or lock the CBS Master Ledger."
      ]
    },
    {
      "dot": "rose",
      "title": "Temenos T24 Dual Ingress Endpoints & Saga",
      "items": [
        "Endpoint 1 (/funds-transfer): Processes standard debit/credit mutations and updates balance_master in Azure SQL.",
        "Endpoint 2 (/reversal): Ingested by Saga Coordinator during failures to restore debited amounts and post reversing ledger journals."
      ]
    }
