    {
      "dot": "emerald",
      "title": "Temenos T24 Endpoint 1: Funds Transfer",
      "items": [
        "Primary Settlement: Orchestrator translates validated requests into T24 OFS commands (FUNDS.TRANSFER,AUTH) dispatched to /api/v1/t24/funds-transfer.",
        "ACID Balance Locking: T24 acquires row-level pessimistic locks (UPDLOCK, ROWLOCK) in Azure SQL, guaranteeing strict balance consistency."
      ]
    },
    {
      "dot": "rose",
      "title": "Temenos T24 Endpoint 2: Compensating Reversal",
      "items": [
        "Saga Recovery: Triggered immediately when downstream notifications, network timeouts, or circuit breakers trip.",
        "Balance Restitution: Endpoint 2 (/api/v1/t24/reversal) reverses ledger postings using the original transaction reference, ensuring zero funds leakage."
      ]
    }
