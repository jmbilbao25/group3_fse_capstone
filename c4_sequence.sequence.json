  "cards": [
    {
      "dot": "emerald",
      "title": "BFF Store & State Isolation",
      "items": [
        "Pre-Mutation Drafts: Client requests first record an active draft in bff_db (:5433), enabling client reconnects and crash recovery.",
        "Zero Lock Bleed: Draft status transitions in bff_db execute completely isolated from Azure SQL CBS Master DB."
      ]
    },
    {
      "dot": "rose",
      "title": "T24 Endpoint 1 vs Endpoint 2 Invocation",
      "items": [
        "Endpoint 1 (/funds-transfer): Executes debit/credit settlement, serializing customer balance locks in Azure SQL (:1433).",
        "Endpoint 2 (/reversal): Called during downstream timeout or error to trigger an atomic compensating rollback and balance restitution."
      ]
    }
  ]
