        "id": "perimeter-screening",
        "label": "Perimeter & Auth Ingress",
        "focus": [
          "mobile_app",
          "web_app",
          "gateway",
          "redis_tier",
          "account_service"
        ],
        "note": "Calls hit Gateway :8080. Auth routes to Account Service :8081, which issues JWTs and tracks Refresh Token Rotation (RTR) in Redis."
      },
      {
        "id": "risk-screening",
        "label": "Async Risk Scoring & Core Simulation",
        "focus": [
          "gateway",
          "orchestrator",
          "risk_engine",
          "temenos_mock"
        ],
        "note": "Spring Boot holds DB tx while Python asyncio scores risk. Scores > 0.85 or > 200ms drop. Valid txs generate raw OFSCore strings."
      },
      {
        "id": "high-value-otp",
        "label": "High-Value OTP Verification (>50k)",
        "focus": [
          "orchestrator",
          "master_db",
          "kafka_bus",
          "notif_service",
          "redis_tier"
        ],
        "note": "Transfers > 50k PHP trigger a soft balance hold. A 6-digit OTP is sent via Kafka and email with a 5-min Redis TTL before settlement."
      },
      {
        "id": "datadog-audit",
        "label": "Datadog APM & Audit Vault",
        "focus": [
          "gateway",
          "datadog",
          "kafka_bus",
          "audit_vault"
        ],
        "note": "W3C traces stream to Datadog Agent for APM waterfalls and live logs, while Kafka streams immutable audit records to PostgreSQL."
      }
    ]
  },
