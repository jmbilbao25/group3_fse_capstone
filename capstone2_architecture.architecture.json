  "cards": [
    {
      "dot": "amber",
      "title": "Account Auth, Fraud & 2FA OTP Rules",
      "items": [
        "Account & Auth Service (:8081): Issues HMAC-SHA256 JWT access tokens (15m TTL) and tracks Refresh Token Rotation (RTR) families in Redis.",
        "Async Risk Engine (Python :8084): Transfers scored 0.00-1.00; score > 0.85 drops immediately within <=200ms SLA.",
        "High-Value OTP (> 50k PHP): Soft hold placed on available balance; 6-digit OTP delivered via email with 5-min Redis TTL."
      ]
    },
    {
      "dot": "violet",
      "title": "Flutter Parity, Security & Chaos",
      "items": [
        "Flutter Omnichannel Parity: Single Flutter codebase deployed to iOS, Android, and Web with 100% UI and business logic parity.",
        "Perimeter & Redis State: Spring Cloud Gateway (:8080) validates JWTs, Redis RTR refresh token families, and rate limits (>10 rps -> 429).",
        "Chaos Testing Protocols: 1) DB degradation choke, 2) Risk engine container kill (<=200ms SLA), and 3) Perimeter port attack."
      ]
    }
  ]
