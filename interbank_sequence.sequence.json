  "cards": [
    {
      "dot": "emerald",
      "title": "Bilateral Inter-Bank Settlement Mechanism",
      "items": [
        "Pre-Funded Settlement Accounts: AuraBank holds a clearing ledger account (NOSTRO_BANK_B) and Partner Bank holds a VOSTRO_AURABANK account.",
        "Zero Loss Invariant: Money is never created or destroyed. Debiting Alice is paired with crediting the Nostro buffer. Debiting the Vostro buffer is paired with crediting Bob.",
        "Saga Compensation Guarantee: If the partner bank cannot be reached or rejects the beneficiary, AuraBank T24 CBS Reversal automatically restores the customer balance."
      ]
    }
