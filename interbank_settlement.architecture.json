  "cards": [
    {
      "dot": "emerald",
      "title": "Bilateral Settlement Model: Aura Bank & CooBS",
      "items": [
        "Pre-Funded Settlement Buffers: Aura Bank maintains ACC-SETTLEMENT-COOBS in its CBS. CooBS maintains ACC-SETTLEMENT-AURABANK in its CBS (each seeded with a 5,000,000 PHP buffer).",
        "Direct Ledger Postings: Debiting Alice credits the CooBS buffer in Aura Bank. Debiting the Aura Bank buffer credits Bob in CooBS. Money is never created or destroyed.",
        "Zero Third-Party Dependency: No centralized clearing switch needed. Both institutions agree on an authenticated JSON HTTP contract for instant bilateral settlement."
      ]
    },
    {
      "dot": "amber",
      "title": "Outbound & Inbound Inter-Bank Wire Lifecycle",
      "items": [
        "Leg 1 (Domestic Debit): Aura Bank Orchestrator executes internal CBS transfer (Debit: Alice 1,000 PHP, Credit: ACC-SETTLEMENT-COOBS).",
        "Leg 2 (Wire Dispatch): Orchestrator sends standard HTTP POST to CooBS endpoint POST /api/v1/interbank/transfers/inbound with reference number.",
        "Leg 3 (Beneficiary Credit): CooBS CBS executes internal transfer (Debit: ACC-SETTLEMENT-AURABANK, Credit: Bob) and returns 200 OK with status SUCCESS.",
        "Saga Compensation (Rollback): If CooBS returns an error or times out, Aura Bank Orchestrator calls CBS reversal to immediately refund Alice."
      ]
    }
  ]
