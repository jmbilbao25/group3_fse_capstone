{
  "info": {
    "_postman_id": "c7a8b3d1-e56f-4a8b-9021-f8e2190abc01",
    "name": "FSE Retail Banking API",
    "description": "Comprehensive Postman Collection for Group 3 FSE Capstone Retail Banking & Ledger Mutation Engine.\n\n### Authentication\nRun **Authentication > 2. Customer Login** first. A Postman Test script will automatically save the `access_token` into the `{{bearer_token}}` collection variable for all subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "bearer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "USR-882190",
      "type": "string"
    },
    {
      "key": "account_id",
      "value": "ACC-1002938471",
      "type": "string"
    },
    {
      "key": "transfer_id",
      "value": "TRX-4491-0021",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Identity",
      "item": [
        {
          "name": "1. Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.delacruz@example.ph\",\n  \"password\": \"SecurePassword123!\",\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Dela Cruz\",\n  \"middle_name\": \"Santos\",\n  \"date_of_birth\": \"1992-05-14\",\n  \"phone_number\": \"+639171234567\",\n  \"address_line\": \"123 Ayala Avenue, Makati City\",\n  \"government_id_type\": \"PASSPORT\",\n  \"government_id_number\": \"P9921840A\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Registers a new customer profile with KYC information."
          }
        },
        {
          "name": "2. Customer Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.access_token) {",
                  "        pm.collectionVariables.set('bearer_token', data.access_token);",
                  "        console.log('Saved bearer_token to collection variables');",
                  "    }",
                  "    if (data.user_id) {",
                  "        pm.collectionVariables.set('user_id', data.user_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan.delacruz@example.ph\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates user credentials and captures JWT into {{bearer_token}}."
          }
        },
        {
          "name": "3. Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Exchanges single-use refresh token cookie for new JWT and rotated refresh token."
          }
        },
        {
          "name": "4. Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Terminates active session and blacklists token in Redis."
          }
        }
      ]
    },
    {
      "name": "2. Accounts & Balances",
      "item": [
        {
          "name": "1. List Accounts",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            },
            "description": "Lists accounts belonging to the authenticated user."
          }
        },
        {
          "name": "2. Get Balance (Redis Cached)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{account_id}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{account_id}}", "balance"]
            },
            "description": "Retrieves real-time breakdown of current, held, and spendable available balance."
          }
        },
        {
          "name": "3. Provision Account (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"account_type\": \"SAVINGS\",\n  \"initial_deposit\": 5000.0000,\n  \"currency\": \"PHP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts"]
            },
            "description": "Provisions a new bank account with initial balance."
          }
        },
        {
          "name": "4. Update Account Status (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\",\n  \"reason\": \"KYC verification approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/accounts/{{account_id}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "accounts", "{{account_id}}", "status"]
            },
            "description": "Locks, unlocks, or closes an account."
          }
        }
      ]
    },
    {
      "name": "3. Balance Mutation Engine (CME)",
      "item": [
        {
          "name": "1. Direct Balance Mutation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transaction_id\": \"TX-{{$timestamp}}\",\n  \"account_id\": \"{{account_id}}\",\n  \"mutation_type\": \"DEBIT\",\n  \"mutation_amount\": 5000.0000,\n  \"currency\": \"PHP\",\n  \"reference_note\": \"Postman direct settlement test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/mutate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ledger", "mutate"]
            },
            "description": "Direct debit/credit under SELECT ... FOR UPDATE pessimistic row locking."
          }
        },
        {
          "name": "2. Query Pending Maker-Checker Queue",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ledger", "pending"]
            },
            "description": "Fetches transactions exceeding PHP 50,000 awaiting secondary checker approval."
          }
        },
        {
          "name": "3. Approve Pending Transaction",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"TX-100293\",\n  \"checkerUserId\": \"usr-1003-tel-001\",\n  \"remarks\": \"Verified identity and funds source\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ledger", "approve"]
            },
            "description": "Authorizes high-value transaction, settles balances, and emits completion event."
          }
        },
        {
          "name": "4. Reject Pending Transaction",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactionId\": \"TX-100293\",\n  \"checkerUserId\": \"usr-1003-tel-001\",\n  \"remarks\": \"Customer cancellation requested\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ledger/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ledger", "reject"]
            },
            "description": "Rejects pending transaction and releases held funds back to sender."
          }
        }
      ]
    },
    {
      "name": "4. Funds Transfers",
      "item": [
