              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_account_id\": \"ACC-1002938471\",\n  \"destination_account_id\": \"ACC-2009847192\",\n  \"transfer_type\": \"SAME_BANK\",\n  \"destination_bank_code\": \"THIS_BANK\",\n  \"amount\": 15000.0000,\n  \"currency\": \"PHP\",\n  \"remarks\": \"Postman transfer test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers"]
            },
            "description": "Initiates transfer between two accounts with deterministic lock ordering."
          }
        },
        {
          "name": "2. Get Transfer Status",
          "request": {
            "auth": {
              "type": "bearer",
