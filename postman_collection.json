              "raw": "{{baseUrl}}/api/v1/transfers/{{transfer_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "{{transfer_id}}"]
            },
            "description": "Queries final settlement status of a transfer."
          }
        },
        {
          "name": "3. Pending Transfers Queue",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearer_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transfers/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "transfers", "pending"]
            },
            "description": "Lists high-value transfers awaiting teller/checker approval."
          }
        }
      ]
    },
